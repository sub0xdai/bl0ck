# Lina AI Agent - Runtime Container
# Application is pre-built by CI, this just runs it
FROM docker.io/oven/bun:1.2.21-debian

WORKDIR /app

# Copy pre-built application and dependencies
COPY package.json bun.lock ./
COPY dist ./dist
COPY node_modules ./node_modules
COPY start-server.ts ./

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/healthz || exit 1

# Start command
CMD ["bun", "run", "start"]
