{
  "name": "@elizaos/plugin-drift",
  "version": "1.0.0",
  "description": "Drift Protocol perpetual futures trading plugin for ElizaOS (Solana)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --watch",
    "typecheck": "tsc --project tsconfig.build.json --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@elizaos/core": "alpha",
    "@drift-labs/sdk": "^2.151.0",
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/web3.js": "^1.95.0"
  },
  "peerDependencies": {
    "@elizaos/core": "alpha"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/node": "^22.15.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "workspaces": {
      "preserveIfPresent": true
    }
  }
}
